# ==============================================================================
# DetectiveAI - Environment Configuration
# ==============================================================================

# LLM Configuration
# Options: "demo" (default offline deterministic agent engine), "openai", "groq", "anthropic", "google"
LLM_PROVIDER=demo

# Model selection (e.g. gpt-4o-mini, gpt-4o, llama-3.3-70b-versatile, gemini-1.5-flash)
MODEL_NAME=demo-engine

# API Keys (leave blank or unset to use the built-in deterministic demo engine)
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Database & Storage
DATABASE_URL=sqlite:///./detectiveai.db
CHROMA_PERSIST_DIR=./chroma_db

# Investigation Workflow Parameters
MAX_CRITIC_RETRIES=2
LOG_LEVEL=INFO
